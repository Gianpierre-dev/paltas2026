# Renombrar a .env y completar con valores reales (NO se commitea)

# PostgreSQL
DATABASE_URL="postgresql://paltas:CAMBIAME@localhost:5432/paltas2026?schema=public"

# JWT — access token corto, refresh token largo con rotación stateful en DB
JWT_SECRET="genera-uno-largo-y-aleatorio-con-openssl-rand-hex-32"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_TTL_DAYS="7"

# Server
PORT=3001
NODE_ENV="development"

# CORS — en prod, setear a la URL del frontend en Railway
CORS_ORIGIN="http://localhost:3000"
