# Renombrar a .env y completar con valores reales.
# Local: PORT del API = 4000, frontend en 5000.
# Railway: PORT lo inyecta Railway automáticamente — no lo seteás vos.

# PostgreSQL
DATABASE_URL="postgresql://paltas:CAMBIAME@localhost:5432/paltas2026?schema=public"

# JWT — access token corto, refresh token largo con rotación stateful en DB
JWT_SECRET="genera-uno-largo-y-aleatorio-con-openssl-rand-hex-32"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_TTL_DAYS="7"

# Server
PORT=4000
NODE_ENV="development"

# CORS — frontend local en 5000. En prod apuntá al dominio de Railway del web.
CORS_ORIGIN="http://localhost:5000"
