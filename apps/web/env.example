# Renombrar a .env y completar.
# Local: el frontend corre en 5000 (next dev -p 5000) y consume el API local en 4000.
# Railway: PORT lo inyecta Railway — no lo seteás vos.

# Backend URL público (lo usa el browser del usuario).
# Local: http://localhost:4000/api
# Railway: https://<dominio-del-service-api>.up.railway.app/api
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# Backend URL para SSR (Server Components / route handlers del BFF).
# En Railway, podés apuntar a la red privada del proyecto para ahorrar egress:
#   API_URL_INTERNAL="http://paltas2026-api.railway.internal:PORT/api"
# Si no se setea, cae a NEXT_PUBLIC_API_URL.
API_URL_INTERNAL="http://localhost:4000/api"
